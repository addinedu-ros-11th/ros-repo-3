# ============================================================
# Mall-E Project — Root Environment Variables
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# ============================================================


# ────────────────────────────────────────────────
# Database (MySQL)
# Docker Compose 에서 db 서비스에 직접 주입됩니다.
# ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=malle
MYSQL_CHARACTER_SET_SERVER=utf8mb4
MYSQL_COLLATION_SERVER=utf8mb4_unicode_ci


# ────────────────────────────────────────────────
# malle_service
# ────────────────────────────────────────────────

# 데이터베이스 연결 URL
# Docker 사용 시: mysql+aiomysql://root:password@db:3306/malle
DB_URL=mysql+aiomysql://root:password@localhost:3306/malle

# 서버 바인딩
HOST=0.0.0.0
PORT=8000

# CORS 허용 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8001

# AI 서비스 URL
# Docker 사용 시: http://malle-ai:5000
AI_SERVICE_URL=http://localhost:5000

# WebSocket 디버그 로그 활성화 (1=on, 0=off)
WS_DEBUG_LOGS=0


# ────────────────────────────────────────────────
# Bridge Node URL  (malle_service ↔ malle_bot 공통)
# malle_service 에서 로봇에 명령 전송 시 사용하는 기본 URL
# Docker 사용 시: http://malle-bridge:9100
# ────────────────────────────────────────────────
BRIDGE_NODE_URL=http://localhost:9100


# ────────────────────────────────────────────────
# malle_bot — bridge_node
# ────────────────────────────────────────────────

# 이 로봇의 ID (정수)
ROBOT_ID=1

# ROS2 네임스페이스 (생략 시 malle_<ROBOT_ID> 자동 사용)
ROBOT_NAMESPACE=malle_1

# malle_service 의 API 엔드포인트
# Docker 사용 시: http://malle-service:8000/api/v1
MALLE_SERVICE_URL=http://localhost:8000/api/v1

# bridge_node HTTP 서버 포트
BRIDGE_HTTP_PORT=9100

# malle_service 가 이 bridge_node 를 등록할 때 쓰는 외부 URL
# 로봇 IP 로 설정 (예: http://192.168.4.10:9100), 빈 값이면 미등록
BRIDGE_SELF_URL=

# 카메라 프레임을 malle_service 로 push 할지 여부 (1=on, 0=off)
CAMERA_PUSH_ENABLED=1


# ────────────────────────────────────────────────
# malle_bot — cam_node
# ────────────────────────────────────────────────
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15


# ────────────────────────────────────────────────
# malle_bot — lockbox_controller
# 잠금장치 인터페이스 (mock | gpio | serial)
# ────────────────────────────────────────────────
LOCKBOX_IFACE=mock


# ────────────────────────────────────────────────
# 테스트 파라미터 (test/ 디렉토리 스크립트용)
# ────────────────────────────────────────────────
TEST_ROBOT_A=1
TEST_ROBOT_B=2
TEST_SESSION_B=1
TEST_POI_ID=1
TEST_HOLD_SEC=5
